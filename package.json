{
  "name": "valyu-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hostable Model Context Protocol server for Valyu search, content extraction and DeepResearch.",
  "license": "MIT",
  "repository": "github:valyuAI/valyu-mcp",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stdio": "tsx stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:format && pnpm test:length && pnpm test:research && pnpm test:entitlements && pnpm test:stdio",
    "test:format": "node --experimental-default-type=module --experimental-strip-types --test scripts/test-format.mjs",
    "test:length": "node --experimental-default-type=module --experimental-strip-types --test scripts/test-response-length.mjs",
    "test:research": "node --experimental-default-type=module --experimental-strip-types --test scripts/test-deepresearch.mjs",
    "test:entitlements": "node scripts/test-entitlements.mjs",
    "test:stdio": "node --test scripts/test-stdio.mjs",
    "test:protocol": "node scripts/test-protocol.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "next": "15.5.29",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.28",
      "source-map-js": "1.2.2",
      "proxy-addr": "2.0.8",
      "ip-address": "10.7.4",
      "body-parser": "2.4.0",
      "fast-uri": "3.1.9",
      "@hono/node-server": "2.1.3",
      "qs": "6.16.1"
    }
  },
  "packageManager": "pnpm@8.15.7+sha512.c85cd21b6da10332156b1ca2aa79c0a61ee7ad2eb0453b88ab299289e9e8ca93e6091232b25c07cbf61f6df77128d9c849e5c9ac6e44854dbd211c49f3a67adc"
}
